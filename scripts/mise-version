#!/usr/bin/env bash
# Prints the version of mise the images bake: the tag of the mise image that base/Dockerfile
# copies the binary from. CI runs the ladder with this version, so a bump to it is verified
# with the mise it introduces and there is no second pin to keep in step. Refuses unless
# exactly one line names the version.
set -euo pipefail
cd "$(dirname "$0")/.."

mapfile -t found < <(sed -nE 's#^COPY --from=ghcr\.io/jdx/mise:([0-9][0-9A-Za-z.-]*)([@ ].*)?$#\1#p' base/Dockerfile)
if [ "${#found[@]}" -ne 1 ]; then
  echo "mise-version: base/Dockerfile names the mise image on ${#found[@]} lines, expected exactly 1" >&2
  exit 1
fi
echo "${found[0]}"

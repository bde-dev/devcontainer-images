#!/usr/bin/env bash
# Prints the version that follows the highest SemVer tag on stdin (one tag per line) for a
# bump level, or 1.0.0 when there is none. Anything that is not MAJOR.MINOR.PATCH is
# ignored (`stable`), and so is a major of four digits: the project also holds date tags
# (YYYY.M.DD), which would otherwise outrank every real version.
set -euo pipefail

bump=${1:-}
case "$bump" in
  major|minor|patch) ;;
  *) echo "next-version: the bump is major, minor or patch, not '$bump'" >&2; exit 1 ;;
esac

latest=$(grep -E '^(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' | sort -V | tail -n 1 || true)
if [ -z "$latest" ]; then
  echo 1.0.0
  exit 0
fi

IFS=. read -r major minor patch <<<"$latest"
case "$bump" in
  major) echo "$((major + 1)).0.0" ;;
  minor) echo "$major.$((minor + 1)).0" ;;
  patch) echo "$major.$minor.$((patch + 1))" ;;
esac

#!/usr/bin/env bash
# Prints the images whose own directory has changed since their last release, one per
# line. An image with no release yet counts as changed. A change anywhere else in the
# repository (CI, tasks, docs) is not a change to any image, so it releases nothing.
set -euo pipefail
cd "$(dirname "$0")/.."

for image in $(scripts/images); do
  last=$(scripts/last-release "$image")
  # Only the exit status answers here: some git builds print the diff header of a new file
  # even under --quiet, and this script's output is the list of images.
  if [ -z "$last" ] || ! git diff --quiet "$last" HEAD -- "$image/" > /dev/null; then
    echo "$image"
  fi
done

#!/usr/bin/env bash
#MISE description="Rung 1: every image names the version of what it is built on, and the mise CI runs can be read from base (no docker build)"
set -euo pipefail

for image in $(scripts/images); do
  base=$(scripts/base-of "$image")
  echo "$image builds on $base"
done
echo "CI runs the ladder under mise $(scripts/mise-version)"

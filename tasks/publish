#!/usr/bin/env bash
#MISE description="Rung 3: build both images with SBOM attestation and push immutable date tags to Harbor (in-LAN only)"
#MISE depends=["verify"]
# Publishes from the workstation. Pushes must originate inside the LAN: the Cloudflare
# tunnel in front of Harbor caps request bodies well below an image layer, so this task
# refuses to run unless the registry resolves to a private address. Credentials are the
# project-scoped robot only; the task never falls back to the admin account, and the
# login lives in a throwaway DOCKER_CONFIG so the workstation's own docker login is untouched.
set -euo pipefail

REGISTRY=harbor.bde-dev.net
PROJECT=devcontainer-images
BUILDER=devcontainer-images
TAG=${TAG:-$(date +%Y.%-m.%d)}

: "${HARBOR_ROBOT_USERNAME:?set HARBOR_ROBOT_USERNAME (robot\$devcontainer-images+gha)}"
: "${HARBOR_ROBOT_SECRET:?set HARBOR_ROBOT_SECRET (AKV secret harbor-gha-robot-creds)}"
case "$HARBOR_ROBOT_USERNAME" in
  robot\$*) ;;
  *) echo "publish: refusing — $HARBOR_ROBOT_USERNAME is not a robot account" >&2; exit 1 ;;
esac

ip=$(getent ahostsv4 "$REGISTRY" | awk 'NR==1{print $1}')
case "$ip" in
  10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) ;;
  *) echo "publish: refusing — $REGISTRY resolves to ${ip:-nothing}, not an in-LAN address (the tunnel cannot take layer pushes)" >&2; exit 1 ;;
esac

# Attestations need a docker-container builder; the default docker driver cannot push them.
# The builder runs on the host network: the push happens from inside the BuildKit container,
# and a bridged container does not see the host's /etc/hosts split-horizon entry for the
# registry, so it would resolve the public (tunnelled) address and the push would 413.
if ! docker buildx inspect "$BUILDER" 2>/dev/null | grep -q 'network="host"'; then
  docker buildx rm "$BUILDER" >/dev/null 2>&1 || true
  docker buildx create --name "$BUILDER" --driver docker-container \
    --driver-opt network=host --bootstrap >/dev/null
fi

# Isolate the registry login: copy the builder registration across, log in there, discard on exit.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
src=${DOCKER_CONFIG:-$HOME/.docker}
[ -d "$src/buildx" ] && cp -r "$src/buildx" "$tmp/"
export DOCKER_CONFIG="$tmp"
printf '%s' "$HARBOR_ROBOT_SECRET" | docker login "$REGISTRY" -u "$HARBOR_ROBOT_USERNAME" --password-stdin

BASE_REF="$REGISTRY/$PROJECT/base:$TAG"
DOTNET_REF="$REGISTRY/$PROJECT/dotnet:$TAG"

echo "publish: $BASE_REF"
docker buildx build --builder "$BUILDER" -f base/Dockerfile \
  --sbom=true --provenance=mode=min -t "$BASE_REF" --push .

echo "publish: $DOTNET_REF"
docker buildx build --builder "$BUILDER" -f dotnet/Dockerfile \
  --build-arg "BASE=$BASE_REF" \
  --sbom=true --provenance=mode=min -t "$DOTNET_REF" --push .

echo "publish: pushed $TAG"

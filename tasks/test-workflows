on:
  pull_request:
    branches: [main]
permissions:
  contents: read
jobs:
  v:
    runs-on: ubuntu-latest
    env:
      MISE_GITHUB_TOKEN: ${{ github.token }}
    steps:
      - uses: actions/checkout@v7

#!/usr/bin/env bash
#MISE description="Rung 1: no workflow a pull request can trigger can reach a secret, a registry login, the publish route or a write token (no docker build; optionally the directory to scan)"
# A pull request runs code its author wrote, so a workflow it can trigger must hold nothing
# that can publish an image. This reads each workflow's `on:` block and fails any workflow
# that is not positively read as triggered by nothing but `workflow_dispatch` and `schedule`
# (events a pull request cannot fire) when a line of it names a secret, the publish route, a
# registry login, an image push or a write token. Every other workflow is scanned, so a
# trigger this reader does not understand is treated as reachable, never as safe: any
# `pull_request` variant, `issue_comment`, `workflow_run`, `merge_group`, `push`, and any
# `on:` shape it cannot classify with certainty. A write token matters because it can cut a
# release or push a tag without naming a secret, so a scanned workflow also has to declare a
# top-level `permissions:` key: without one the token falls back to the repository default,
# which can be write. A job-level `permissions:` alone does not count, because the other
# jobs would still take the default.
#
# It reads text, so a comment that names one of these fails too: better a reworded comment
# than a credential that slipped past a parser. The checker is tried first on fixtures, so a
# pattern that stopped matching, or an `on:` shape it misreads, fails here before it can let
# a real workflow through.
set -euo pipefail

on_key='^("on"|'"'"'on'"'"'|on)[ \t]*:'

# Prints `safe` when the workflow's `on:` block is positively read as only workflow_dispatch
# and schedule, `scan` for anything else, and fails when the file has no single `on:` key
# to read. Reads the scalar (`on: x`), single-line flow sequence (`on: [x, y]`), block
# mapping and block list (including a list indented no further than `on:`) forms; a flow
# mapping, a quoted event name, a tab in the indentation or anything else is `scan`.
classify() {
  awk -v key="$on_key" '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    function allowed(e) { return e == "workflow_dispatch" || e == "schedule" }
    function classify(s,   i, l, rest, nb, body, ind, m, w, t, k, kind, name, count, inner, nev, parts, j, p) {
      rest = lines[s]
      sub(/(^|[ \t])#.*/, "", rest)
      sub(key, "", rest)
      rest = trim(rest)
      for (i = s + 1; i <= NR; i++) {
        l = lines[i]
        if (l ~ /^(---|\.\.\.)([ \t]|$)/) break
        if (l !~ /^([ \t]|-([ \t]|$)|#|$)/) break
        sub(/(^|[ \t])#.*/, "", l)
        if (l ~ /^[ \t]*$/) continue
        body[++nb] = l
      }
      if (rest != "") {
        if (nb > 0) return "scan"
        if (rest ~ /^[A-Za-z_]+$/) return allowed(rest) ? "safe" : "scan"
        if (rest ~ /^\[[A-Za-z_, \t]*\]$/) {
          inner = substr(rest, 2, length(rest) - 2)
          nev = split(inner, parts, ",")
          for (j = 1; j <= nev; j++) {
            p = trim(parts[j])
            if (p == "") continue
            if (!allowed(p)) return "scan"
            count++
          }
          return count > 0 ? "safe" : "scan"
        }
        return "scan"
      }
      if (nb == 0) return "scan"
      m = -1
      for (i = 1; i <= nb; i++) {
        match(body[i], /^[ \t]*/)
        w = substr(body[i], 1, RLENGTH)
        if (w ~ /\t/) return "scan"
        ind[i] = RLENGTH
        if (m < 0 || RLENGTH < m) m = RLENGTH
      }
      for (i = 1; i <= nb; i++) {
        if (ind[i] != m) continue
        t = substr(body[i], m + 1)
        if (kind == "map" && t ~ /^-([ \t]|$)/) continue
        if (t ~ /^-[ \t]+[A-Za-z_]+[ \t]*$/) { k = "list"; name = t; sub(/^-[ \t]+/, "", name); name = trim(name) }
        else if (t ~ /^[A-Za-z_]+[ \t]*:([ \t].*)?$/) { k = "map"; name = t; sub(/[ \t]*:.*$/, "", name) }
        else return "scan"
        if (kind != "" && kind != k) return "scan"
        kind = k
        if (!allowed(name)) return "scan"
        count++
      }
      return count > 0 ? "safe" : "scan"
    }
    { sub(/\r$/, ""); lines[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) if (lines[i] ~ key) { n++; if (n == 1) first = i }
      if (n == 0) exit 2
      print (n == 1) ? classify(first) : "scan"
    }
  ' "$1"
}

# Succeeds when the workflow declares a top-level `permissions:` key with a value: on the
# key's line (`read-all`, `{}`, a flow mapping) or indented beneath it.
declares_permissions() {
  awk '
    { sub(/\r$/, ""); lines[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) {
        if (lines[i] !~ /^["'"'"']?permissions["'"'"']?[ \t]*:/) continue
        rest = lines[i]
        sub(/^["'"'"']?permissions["'"'"']?[ \t]*:/, "", rest)
        sub(/(^|[ \t])#.*/, "", rest)
        gsub(/[ \t]/, "", rest)
        if (rest != "") exit 0
        for (j = i + 1; j <= NR; j++) {
          l = lines[j]
          sub(/(^|[ \t])#.*/, "", l)
          if (l ~ /^[ \t]*$/) continue
          exit (l ~ /^[ \t]/ ? 0 : 1)
        }
        exit 1
      }
      exit 1
    }
  ' "$1"
}

labels=(
  "a secret"
  "the publish route"
  "a registry login"
  "an image push"
  "a write token"
)
patterns=(
  '\bsecrets\b'
  'harbor'
  'login-action|\b(docker|podman|buildah|skopeo|oras|crane|regctl|cosign|helm)\b.*\blogin\b'
  'build-push-action|--push\b|\bpush:[[:space:]]*true|\b(docker|podman|buildah|skopeo|oras|crane|regctl)\b.*\bpush\b|\b(mise|tasks/).*\b(publish|promote-stable)\b'
  ':[[:space:]]*["'"'"']?write(-all)?["'"'"']?[[:space:]]*([,}#].*)?$'
)

# Prints every offence in the workflows under a directory that are not positively
# triggered by nothing but workflow_dispatch and schedule; fails if any.
scan() {
  local dir=$1 file verdict hit i bad=0
  for file in "$dir"/*.yaml "$dir"/*.yml; do
    [ -e "$file" ] || continue
    if ! verdict=$(classify "$file"); then
      echo "test-workflows: $file: no single \`on:\` key to read its triggers from" >&2
      bad=1
      continue
    fi
    [ "$verdict" = safe ] && continue
    if ! declares_permissions "$file"; then
      echo "test-workflows: $file: a workflow a pull request may be able to trigger has no top-level \`permissions:\` key, so its token would fall back to the repository default" >&2
      bad=1
    fi
    for i in "${!patterns[@]}"; do
      while IFS= read -r hit; do
        echo "test-workflows: $file:$hit  <- a workflow a pull request may be able to trigger names ${labels[$i]}" >&2
        bad=1
      done < <(grep -Ein -e "${patterns[$i]}" "$file" || true)
    done
  done
  return "$bad"
}

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
case_n=0
# fixture <pass|fail> <what>, the workflow on stdin: the scan must pass or fail on it.
fixture() {
  local want=$1 what=$2 dir got
  dir="$scratch/$((++case_n))"
  mkdir -p "$dir"
  cat > "$dir/w.yaml"
  if scan "$dir" 2>/dev/null; then got=pass; else got=fail; fi
  [ "$got" = "$want" ] || { echo "test-workflows: $what: scan gave $got, expected $want" >&2; exit 1; }
}

# shellcheck disable=SC2016 # the `${{ }}` below is workflow text, not a shell expansion
jobs_clean='permissions:\n  contents: read\njobs:\n  v:\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo hi\n'
# shellcheck disable=SC2016
jobs_secret='permissions:\n  contents: read\njobs:\n  v:\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo ${{ secrets.TOKEN }}\n'
# shape <what> <on block> [<the shape holding release triggers> [<the same, unconfirmable>]]
# The text is printf %b, so `\n`, `\t` and `\r` write the characters. A <what> that starts
# with CRLF writes the whole file with CRLF line ends.
shape() {
  local what=$1 bad=$2 safe=${3:-} unsure=${4:-}
  local eol=cat
  case "$what" in CRLF*) eol="sed s/\$/\r/" ;; esac
  fixture fail "$what, with a secret" < <(printf '%b%b' "$bad" "$jobs_secret" | $eol)
  fixture pass "$what, clean" < <(printf '%b%b' "$bad" "$jobs_clean" | $eol)
  if [ -n "$safe" ]; then
    fixture pass "$what of release triggers, with a secret" < <(printf '%b%b' "$safe" "$jobs_secret" | $eol)
  fi
  if [ -n "$unsure" ]; then
    fixture fail "$what of release triggers it cannot confirm, with a secret" < <(printf '%b%b' "$unsure" "$jobs_secret" | $eol)
  fi
}


#!/usr/bin/env bash
#MISE description="Rung 1: no workflow a pull request can trigger can reach a secret, a registry login or the publish route (no docker build; optionally the directory to scan)"
# A pull request runs code its author wrote, so a workflow it can trigger must hold nothing
# that can publish an image. This reads each workflow's `on:` block and, for every one with
# a trigger a pull request reaches, fails on any line that names a secret, the publish
# route, a registry login or an image push. It reads text, so a comment that names one
# fails too: better a reworded comment than a credential that slipped past a parser.
#
# The triggers a pull request reaches are `pull_request` and its variants (`_target`,
# `_review`, `_review_comment`), `issue_comment` (a comment on a pull request fires it),
# `workflow_run` (it follows another workflow, including one a pull request started) and
# `merge_group` (it runs the merge of queued pull requests).
#
# The checker is tried first on fixtures, so a pattern that stopped matching fails here
# before it can let a real workflow through.
set -euo pipefail

on_key='^("on"|'"'"'on'"'"'|on)[ \t]*:'
reachable='pull_request|issue_comment|workflow_run|merge_group'

# The workflow's `on:` block, comments removed. Fails when the file has none, so a
# workflow whose triggers cannot be read is refused, never assumed safe.
triggers() {
  awk -v key="$on_key" '
    $0 ~ key                  { in_on = 1; found = 1 }
    !($0 ~ key) && /^[^ \t#]/ { in_on = 0 }
    in_on                     { sub(/[ \t]*#.*/, ""); print }
    END                       { exit !found }
  ' "$1"
}

labels=(
  "a secret"
  "the publish route"
  "a registry login"
  "an image push"
)
patterns=(
  '\bsecrets\b'
  'harbor'
  'login-action|\b(docker|podman|buildah|skopeo|oras|crane|regctl|cosign|helm)\b.*\blogin\b'
  'build-push-action|--push\b|\bpush:[ \t]*true|\b(docker|podman|buildah|skopeo|oras|crane|regctl)\b.*\bpush\b|\b(mise|tasks/).*\b(publish|promote-stable)\b'
)

# Prints every offence in the workflows a pull request can trigger under a directory; fails if any.
scan() {
  local dir=$1 file trig hit i bad=0
  for file in "$dir"/*.yaml "$dir"/*.yml; do
    [ -e "$file" ] || continue
    if ! trig=$(triggers "$file"); then
      echo "test-workflows: $file: no \`on:\` block to read its triggers from" >&2
      bad=1
      continue
    fi
    grep -Eq "$reachable" <<<"$trig" || continue
    for i in "${!patterns[@]}"; do
      while IFS= read -r hit; do
        echo "test-workflows: $file:$hit  <- a workflow a pull request can trigger names ${labels[$i]}" >&2
        bad=1
      done < <(grep -Ein -e "${patterns[$i]}" "$file" || true)
    done
  done
  return "$bad"
}

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
case_n=0
# fixture <pass|fail> <what>, the workflow on stdin: the scan must pass or fail on it.
fixture() {
  local want=$1 what=$2 dir got
  dir="$scratch/$((++case_n))"
  mkdir -p "$dir"
  cat > "$dir/w.yaml"
  if scan "$dir" 2>/dev/null; then got=pass; else got=fail; fi
  [ "$got" = "$want" ] || { echo "test-workflows: $what: scan gave $got, expected $want" >&2; exit 1; }
}

{
  fixture pass "a pull-request workflow with nothing in it" <<'YAML'

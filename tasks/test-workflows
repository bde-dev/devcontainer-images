  # Every shape the `on:` key can take. A pull-request trigger in it fails when the workflow
  # names a secret and passes when the workflow is clean. Where the reader can classify the
  # shape, the same shape holding only release triggers passes even with a secret; where it
  # cannot, that variant still fails, because an unclassified shape is scanned.
  shape "a zero-indented list" 'on:\n- pull_request\n' 'on:\n- workflow_dispatch\n'
  shape "an indented list" 'on:\n  - push\n  - pull_request\n' 'on:\n  - workflow_dispatch\n  - schedule\n'
  shape "a flow sequence" 'on: [push, pull_request]\n' 'on: [workflow_dispatch, schedule]\n'
  shape "a flow sequence with a trailing comma" 'on: [ pull_request, ]\n' 'on: [workflow_dispatch, ]\n'
  shape "a scalar" 'on: pull_request\n' 'on: workflow_dispatch\n'
  shape "a quoted key" '"on":\n  pull_request:\n' '"on":\n  workflow_dispatch:\n'
  shape "a single-quoted key" "'on':\n  pull_request:\n" "'on':\n  workflow_dispatch:\n"
  shape "a key with a space before the colon" 'on :\n  pull_request:\n' 'on :\n  workflow_dispatch:\n'
  shape "a mapping" 'on:\n  pull_request:\n    branches: [main]\n' 'on:\n  workflow_dispatch:\n    inputs:\n      pull_request:\n        required: true\n'
  shape "a mapping with a schedule" 'on:\n  schedule:\n  - cron: "0 3 * * *"\n  pull_request:\n' 'on:\n  schedule:\n  - cron: "0 3 * * *"\n  workflow_dispatch:\n'
  shape "a mapping with comments" 'on:\n  # releases are by hand\n  pull_request:  # and checked\n' 'on:\n  # not pull_request\n  workflow_dispatch:  # by hand\n'
  shape "a tab after the key" 'on:\t[pull_request]\n' 'on:\t[workflow_dispatch]\n'
  shape "CRLF line ends, a list" 'on:\n- pull_request\n' 'on:\n- workflow_dispatch\n'
